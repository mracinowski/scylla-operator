{{ define "resources" -}}
	Resources GVK: {{- "\n" -}}
	{{- range $key, $value := . -}}
		{{- if $value -}}
        	{{- "\t" -}}
			{{- if $value.GetObjectKind.GroupVersionKind.Empty -}}
				No GVK set {{- "\n" -}}
			{{- else -}}
				{{- $value.GetObjectKind.GroupVersionKind.String}} ({{ $value.GetUID }}) {{- "\n" -}}
			{{- end -}}
		{{- end -}}
	{{- end -}}
{{end}}

{{ define "symptom" -}}
	{{.Name}} {{- "\n" -}}
	{{- if .Diagnoses -}}
		Diagnoses: {{- "\n" -}}
		{{- range .Diagnoses -}}
			{{ "\t" }}{{.}} {{- "\n" -}}
		{{- end -}}
	{{- else -}}
		No Diagnoses {{- "\n" -}}
	{{- end -}}
	{{- if .Suggestions -}}
		Suggestions: {{- "\n" -}}
		{{- range .Suggestions -}}
			{{ "\t" }}{{.}} {{- "\n" -}}
	{{- end -}}
	{{- else -}}
		No suggestions {{- "\n" -}}
	{{- end -}}
{{end}}


{{ define "issue" -}}
    {{- if or (not .Symptom) (and (gt (len .Symptom.Diagnoses) 0) (eq (index .Symptom.Diagnoses 0) "Node group") (gt (len .Symptom.Suggestions) 0) (eq (index .Symptom.Suggestions 0) "Node group")) -}}
		No symptom {{- "\n" -}}
	{{- else -}}
        {{- template "symptom" .Symptom -}}
	{{- end}}
	{{- if and (.Resources) (HasValidResources .Resources) -}}
	    {{- template "resources" .Resources -}}
	{{- else -}}
		No resources related to this issue. {{- "\n" -}}
	{{- end -}}
	--- {{- "\n" -}}
{{- end}}